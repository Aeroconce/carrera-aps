# Variables de entorno de Carrera APS. Copiar a `.env` y completar; `.env` queda fuera de git (.gitignore: .env*).
# Fuente: docs/17-runbook-y-entrega.md. Secretos: `openssl rand -base64 48`, guardados en el gestor de contraseñas del equipo.

# Dominio público de la instancia (la demo usa un subdominio dedicado; nunca el dominio de producción futuro)
DOMINIO=

# PostgreSQL 16. Desarrollo: contenedor `db` de docker-compose.yml en localhost:5436. Servidor: host `db`, puerto 5432.
# Escribe la misma contraseña en DB_PASSWORD y dentro de DATABASE_URL (dotenv no expande variables).
DB_PASSWORD=
DATABASE_URL=postgresql://app:***@localhost:5436/carrera
# DATABASE_URL=postgresql://app:***@db:5432/carrera   # en el servidor (Compose)

# Base de datos de prueba para los tests de server actions (docs/16-plan-de-pruebas-y-calidad.md)
DATABASE_URL_TEST=

# Better Auth: secreto de 32+ bytes aleatorios; URL pública = https://${DOMINIO}
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Zona horaria de presentación y cálculo de bienios (almacenamiento siempre en UTC)
TZ=America/Santiago

# Respaldos cifrados con age: clave pública del destinatario
AGE_RECIPIENT=

# Rutas de datos en el servidor (volúmenes en Compose)
DOCUMENTOS_DIR=/data/documentos
LOG_DIR=/data/logs

# Cuenta ADMIN inicial que crea `pnpm seed:bootstrap` (desarrollo y demo). Cambiar la contraseña al primer ingreso.
SEED_ADMIN_EMAIL=admin.demo@carrera-aps.local
SEED_ADMIN_PASSWORD=

# 1 = muestra la nota "Datos de demostración; dotación ficticia" en el pie de todas las pantallas (solo demo)
NEXT_PUBLIC_MODO_DEMO=
